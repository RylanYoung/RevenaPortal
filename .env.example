# Revena Portal — environment variables.
# This file IS committed so the required keys stay documented. Copy it to
# .env.local, fill in real values, then add the same keys in Vercel under
# Project Settings -> Environment Variables.

# --- Admin access ---
# Single shared password for /admin. Client logins are separate (Supabase Auth).
# If this is unset, /admin locks itself rather than falling open.
ADMIN_PASSWORD=

# --- Supabase ---
# Project URL, e.g. https://xxxxx.supabase.co — Project Settings > API
SUPABASE_URL=
# Publishable/anon key (client-safe, RLS still applies) — Project Settings > API
SUPABASE_ANON_KEY=
# Service role key — Project Settings > API. SERVER-SIDE ONLY, never exposed to
# the browser. This is what the webhook and the admin pages write through, and
# it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# --- GHL lead intake ---
# Shared secret guarding /api/webhooks/ghl. Generate a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The full intake URL (with this key appended) is shown on /admin/setup.
GHL_WEBHOOK_SECRET=

# --- MCP server ("Revena Admin") ---
# Bearer token for /api/mcp, which lets you manage clients from a Claude chat.
# ADMIN-SCOPED: anything holding this can read and write every client's data,
# so treat it like the service role key. Generate it the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_API_KEY=
